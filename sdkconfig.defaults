# snoopview: the ESP32-P4 only (Guition JC1060P470C). Taken from esp32-s3-meteobus's sdkconfig.defaults, without
# Wi-Fi, TLS, web server, OTA, core dump and the app's own settings. The board's settings are in
# sdkconfig.defaults.esp32p4 (read after this file).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Console as MeteoBus: UART0 primary (the board's CH340 "USB-TTL" port), USB-Serial-JTAG secondary (the "Full Speed
# USB" port, COM7 on the PC: where the logs are read and the flash goes)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# LVGL 9.2.2
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=0
